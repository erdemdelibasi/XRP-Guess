# Kanal Finans TS'yi bu bilgisayardan (Windows Task Scheduler ile) calistirmak
# icin gerekli. Bu dosyayi ".env" olarak kopyala ve gercek degerleri gir --
# ".env" .gitignore'da, asla commit'lenmez.
#
# SUPABASE_SERVICE_KEY ve ANTHROPIC_API_KEY, GitHub repo Secrets'ta zaten
# kayitli olan degerlerle AYNI olmali (Settings -> Secrets and variables ->
# Actions'ta goremezsin, degerleri ilk olusturdugunda kaydettigin yerden al).
SUPABASE_URL=https://sehiookymtopjfeiyrti.supabase.co
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
