# Kanal Finans TS'yi bu bilgisayardan (Windows Task Scheduler ile) calistirmak
# icin gerekli. Bu dosyayi ".env" olarak kopyala ve gercek degerleri gir --
# ".env" .gitignore'da, asla commit'lenmez.
#
# SUPABASE_SERVICE_KEY, GitHub repo Secrets'ta zaten kayitli olan degerle
# AYNI olmali (Settings -> Secrets and variables -> Actions'ta goremezsin,
# degeri ilk olusturdugunda kaydettigin yerden al). API anahtari gerekmez:
# Kanal Finans cikarimi ../Kanal-Finans-Fetcher'da, abonelikle yapiliyor.
SUPABASE_URL=https://sehiookymtopjfeiyrti.supabase.co
SUPABASE_SERVICE_KEY=
